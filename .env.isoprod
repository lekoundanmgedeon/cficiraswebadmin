# Variables ISOPROD — buildées dans le bundle Vite.
# Servent au build local pour reproduire l'env Render isoprod.
# Sur Render, les vraies valeurs viennent de render.yaml.

VITE_API_URL=https://cfibackend-isoprod.up.railway.app
VITE_APP_NAME=CFI CIRAS Web Admin — ISOPROD
VITE_DEBUG=true
VITE_BASE_URL=/
VITE_ENV=isoprod
VITE_PUBLIC_KEY=cficiras2026
NODE_ENV=production
